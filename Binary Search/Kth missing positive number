// Brute Force
class Solution {
public:
    int findKthPositive(vector<int>& arr, int k) {
        int n = arr.size();
        int maxVal = arr.back();
        int target = maxVal + k;
        int count = 0;
        for(int i = 1; i<=target; i++){
            bool found = false;
            for(int j = 0; j<n; j++){
                if(arr[j] == i){
                    found = true;
                    break;
                }
            }
            if(!found){
                count ++;
                if(count == k) return i;
            }
        }
        return -1;
    }
};
