class Solution {
public:
    vector<int> rearrangeArray(vector<int>& nums) {
        int n = nums.size();
        vector<int>arr(n);
        int positiveIndex = 0;
        for(int i = 0; i<n; i++){
            if(nums[i] > 0){
                arr[positiveIndex] = nums[i];
                positiveIndex = positiveIndex + 2;
            }
        }
        int negativeindex = 1;
        for(int i = 0; i<n; i++){
            if(nums[i] < 0){
                arr[negativeindex] = nums[i];
                negativeindex = negativeindex + 2;
            }
        }
        return arr;
    }
};
